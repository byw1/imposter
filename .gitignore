# Brand assets. Reserved brand property, not covered by any code licence.
# The exported PNGs in /assets are committed because the app will not build
# without them. The editable sources and store artwork stay out.
/brand/
*.sketch
*.fig
*.afdesign
*.afphoto
*.ai
*.psd
/assets/icon-source.*
/assets/wordmark.*
/store/
/screenshots/

